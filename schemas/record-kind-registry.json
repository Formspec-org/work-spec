{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wos.standard/schemas/record-kind-registry.json",
  "title": "WOS Record Kind Registry",
  "description": "Canonical registry of all ProvenanceKind variants. 134 total — 23 carry schema-validated payload shapes (if/then guards or prov-log $def overlays), 111 are flat Facts-tier records. Every literal maps 1:1 to a ProvenanceKind Rust enum variant (crates/wos-events/src/provenance/kind.rs) under serde(rename_all=\"camelCase\"). The API FactsRecordKind taxonomy derives from this registry; D26 wire records dispatch by event literal. Admission/event-type catalog instances are generated from ProvenanceKind::canonical_event_literal() at build/runtime boundaries and CI-check this registry as a mirror. See specs/provenance-registry.md for governance policy on adding/removing record categories.",
  "type": "object",
  "properties": {
    "registryVersion": {
      "type": "string",
      "description": "Semantic version. Minor bump when record kinds are added. Major bump when a kind is removed (breaking API change)."
    },
    "lastAudited": {
      "type": "string",
      "format": "date"
    },
    "totalCount": {
      "type": "integer",
      "description": "Total ProvenanceKind variants in the Rust enum at last audit."
    },
    "schemaValidatedCount": {
      "type": "integer",
      "description": "Variants carrying schema-validated payload shapes (if/then or $def overlay)."
    },
    "admissionContract": {
      "type": "object",
      "description": "Contract for the WOS event-type/admission registry surface. This block defines the source and dispatch shape; the instance event literals themselves remain on recordKinds[].eventLiteral and MUST match ProvenanceKind::canonical_event_literal().",
      "additionalProperties": false,
      "properties": {
        "source": {
          "const": "ProvenanceKind::canonical_event_literal()"
        },
        "runtimeSurface": {
          "const": "GET /v1/scopes/{scope}/registries/event-types"
        },
        "dispatchField": {
          "const": "event"
        },
        "legacyRecordKindField": {
          "const": "recordKind"
        },
        "instanceGeneration": {
          "type": "string"
        }
      },
      "required": [
        "source",
        "runtimeSurface",
        "dispatchField",
        "legacyRecordKindField",
        "instanceGeneration"
      ]
    },
    "sources": {
      "type": "object",
      "properties": {
        "rustEnum": {
          "type": "string"
        },
        "kernelSchema": {
          "type": "string"
        },
        "apiProvenanceSchema": {
          "type": "string"
        },
        "parityScript": {
          "type": "string"
        },
        "adrs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "recordKinds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "literal": {
            "type": "string"
          },
          "rustVariant": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "schemaValidated": {
            "type": "boolean"
          },
          "eventLiteral": {
            "type": "string",
            "pattern": "^wos\\.(kernel|governance|ai|assurance)\\.[a-z][a-z0-9]*(?:_[a-z0-9]+)*$",
            "description": "Optional F-13 custody/export event literal when this record category has a ratified WOS-owned event type. The event literal is the authoritative dispatch key for migrated overlays and MUST equal ProvenanceKind::<rustVariant>::canonical_event_literal(); `literal` remains the internal ProvenanceKind name."
          },
          "specReference": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "literal",
          "rustVariant",
          "category",
          "schemaValidated"
        ]
      }
    }
  },
  "registryVersion": "1.2.0",
  "lastAudited": "2026-05-13",
  "totalCount": 141,
  "schemaValidatedCount": 23,
  "admissionContract": {
    "source": "ProvenanceKind::canonical_event_literal()",
    "runtimeSurface": "GET /v1/scopes/{scope}/registries/event-types",
    "dispatchField": "event",
    "legacyRecordKindField": "recordKind",
    "instanceGeneration": "Build/runtime code derives event-type catalog instances from ProvenanceKind::canonical_event_literal(); recordKinds[].eventLiteral is a CI-checked registry mirror, not the authoring source."
  },
  "sources": {
    "rustEnum": "crates/wos-events/src/provenance/kind.rs",
    "kernelSchema": "schemas/wos-workflow.schema.json",
    "apiProvenanceSchema": "schemas/api/provenance.schema.json",
    "parityScript": "scripts/check-recordkind-parity.py",
    "adrs": [
      "thoughts/adr/0062-signature-profile-workflow-semantics.md",
      "thoughts/adr/0066-stack-amendment-and-supersession.md",
      "thoughts/adr/0067-stack-statutory-clocks.md",
      "thoughts/adr/0068-stack-tenant-and-scope-composition.md",
      "thoughts/adr/0069-stack-time-semantics.md",
      "thoughts/adr/0070-stack-failure-and-compensation.md",
      "thoughts/adr/0071-stack-cross-layer-migration-and-versioning.md",
      "thoughts/adr/0091-keyrebind-recovery-flow.md"
    ]
  },
